# ==============================================================================
# RevPilot Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values as needed.
# All settings have sensible defaults for running out-of-the-box in simulation mode.

# --- Core Application ---
REVPILOT_APP_NAME=RevPilot
REVPILOT_DEBUG=false
REVPILOT_LOG_LEVEL=INFO

# --- Database / Persistence ---
# File-based structured JSON/JSONL output directory
REVPILOT_DATABASE_URL=sqlite:///./revpilot.db

# --- Deterministic Guardrail Limits ---
REVPILOT_MAX_RETRIES_PER_PAYMENT=3
REVPILOT_MAX_RETRIES_PER_CARD_24H=5
REVPILOT_GUARDRAIL_COOLOFF_SECONDS=300

# --- Thompson Sampling Bandit Priors ---
REVPILOT_BANDIT_PRIOR_ALPHA=1.0
REVPILOT_BANDIT_PRIOR_BETA=1.0

# --- Optional LLM Diagnosis Configuration ---
# RevPilot uses deterministic regex rule-based failure diagnosis by default.
# Enabling LLM provides semantic root-cause interpretation (never financial execution).
REVPILOT_LLM_ENABLED=false
REVPILOT_LLM_PROVIDER=gemini
REVPILOT_LLM_MODEL=gemini-2.5-flash
REVPILOT_LLM_TIMEOUT_SECONDS=5.0
REVPILOT_LLM_MAX_RETRIES=2

# Gemini API Key (optional - only needed if REVPILOT_LLM_ENABLED=true)
# Can also be provided as GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=
REVPILOT_GEMINI_API_KEY=

# Optional Razorpay API Integration (Simulator mode active by default)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

