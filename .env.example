# RevPilot Environment Configuration
# Copy to .env and adjust values as needed.

REVPILOT_DEBUG=true
REVPILOT_DATABASE_URL=sqlite:///./revpilot.db
REVPILOT_MAX_RETRIES_PER_PAYMENT=3
REVPILOT_MAX_RETRIES_PER_CARD_24H=5
REVPILOT_BANDIT_PRIOR_ALPHA=1.0
REVPILOT_BANDIT_PRIOR_BETA=1.0
REVPILOT_GUARDRAIL_COOLOFF_SECONDS=300
REVPILOT_LLM_PROVIDER=gemini
REVPILOT_LLM_MODEL=gemini-2.5-flash
REVPILOT_LOG_LEVEL=INFO
